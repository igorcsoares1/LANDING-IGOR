{
  "entities": {
    "booking": {
      "title": "Booking",
      "description": "Appointment request from potential patients",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name" },
        "email": { "type": "string", "format": "email", "description": "Contact email" },
        "phone": { "type": "string", "description": "WhatsApp number" },
        "preferredTimes": { "type": "string", "description": "Preferred appointment times" },
        "message": { "type": "string", "description": "Initial concern or message" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["name", "email", "phone", "createdAt"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": "booking",
      "description": "Collection of appointment requests"
    }
  }
}
