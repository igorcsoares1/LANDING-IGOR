rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Validation for bookings
    function isValidBooking(data) {
      return data.keys().hasAll(['name', 'email', 'phone', 'createdAt']) &&
             data.keys().size() <= 6 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 200 &&
             data.phone is string && data.phone.size() <= 50 &&
             data.createdAt == request.time &&
             (!('message' in data) || (data.message is string && data.message.size() <= 2000)) &&
             (!('preferredTimes' in data) || (data.preferredTimes is string && data.preferredTimes.size() <= 500));
    }

    match /bookings/{bookingId} {
      allow create: if isValidId(bookingId) && isValidBooking(incoming());
      // No read access for public to prevent data leaks
      allow read, update, delete: if false;
    }
  }
}
